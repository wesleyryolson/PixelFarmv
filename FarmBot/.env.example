# Twitch application Client ID (Developer Console → Applications → Manage)
CLIENT_ID=your_twitch_client_id

# User access token for the bot account. Do not include an "oauth:" prefix.
# Required scopes: user:read:chat user:write:chat
# Add user:manage:whispers for private !shop and !leaderboard replies.
OAUTH_TOKEN=your_bot_user_access_token

# Numeric Twitch User ID for the account that owns OAUTH_TOKEN
BOT_USER_ID=your_bot_user_id

# Numeric Twitch User ID for the channel where the farm will run
CHAT_CHANNEL_USER_ID=your_channel_user_id

# Optional user token for the channel owner with channel:read:subscriptions.
# Required for real new-subscriber flowers when OAUTH_TOKEN belongs to the bot.
CHANNEL_OWNER_OAUTH_TOKEN=

# Optional AI keys for generated crop modifier words and tint colors.
# If both are set, OpenAI is used. If neither is set, built-in local presets are used.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Require multiple unique chatter votes to harvest, scaled by active chatters.
# false/unset lets one chatter harvest as usual.
DYNAMIC_HARVEST=false
