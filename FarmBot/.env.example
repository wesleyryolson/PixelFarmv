# Twitch application Client ID (Developer Console → Applications → Manage)
CLIENT_ID=your_twitch_client_id

# User access token for the bot account. Do not include an "oauth:" prefix.
# Required scopes: user:read:chat user:write:chat
# Add user:manage:whispers for the private !shop reply.
OAUTH_TOKEN=your_bot_user_access_token

# Numeric Twitch User ID for the account that owns OAUTH_TOKEN
BOT_USER_ID=your_bot_user_id

# Numeric Twitch User ID for the channel where the farm will run
CHAT_CHANNEL_USER_ID=your_channel_user_id
